---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <div class="box">
    <fieldset class="inner markdown">
      <legend>404</legend>
      <p>That page is not here. It may have been renamed, or the link that sent you here is wrong.</p>
      <p><a href="/">Go to the home page</a> or <a href="/blog">read the blog</a>.</p>
    </fieldset>
  </div>
</Base>
