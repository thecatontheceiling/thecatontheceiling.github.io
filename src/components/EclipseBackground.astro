---
const canvasStyle = 'position:absolute;inset:0;width:100%;height:100%;image-rendering:pixelated';
---
<div class="eclipse-bg" aria-hidden="true" style="position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none">
  <canvas data-eclipse-field style={canvasStyle}></canvas>
  <canvas data-eclipse-stars style={canvasStyle}></canvas>
</div>

<script>
  import { initEclipse } from '../lib/eclipse.js';
  try {
    initEclipse();
  } finally {
    document.documentElement.setAttribute('data-eclipse', 'ready');
  }
</script>
