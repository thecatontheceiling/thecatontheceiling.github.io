<div class="eclipse-bg" aria-hidden="true">
  <canvas data-eclipse-field></canvas>
  <canvas data-eclipse-stars></canvas>
</div>

<style>
  .eclipse-bg {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 100vh;
    height: 100lvh;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .eclipse-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
</style>

<script>
  import { initEclipse } from '../lib/eclipse.js';
  try {
    initEclipse();
  } finally {
    document.documentElement.setAttribute('data-eclipse', 'ready');
  }
</script>
